# Copy this file to server/.env. Never commit server/.env.
# Node.js >=20.6 supports: node --env-file=server/.env server/ai-proxy.mjs
DEEPSEEK_API_KEY=replace-with-your-server-only-key
DEEPSEEK_MODEL=deepseek-chat
HOST=127.0.0.1
PORT=8787

# Recommended locally; mandatory (minimum 24 characters) for a public bind.
# Generate a random token, then enter the same token in the web app connection settings.
DEMO_ACCESS_TOKEN=replace-with-a-random-token-at-least-24-characters

# Exact browser origins, comma-separated; no path, wildcard, or trailing slash.
ALLOWED_ORIGIN=http://localhost:4173
# Public example (after deploying the relay behind HTTPS):
# HOST=0.0.0.0
# ALLOWED_ORIGIN=https://rosannabebe.github.io
